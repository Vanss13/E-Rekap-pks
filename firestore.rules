rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all for any unmapped path
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Peserta & Kontingen Lomba
    match /participants/{participantId} {
      allow read: if true;
      allow write: if isValidId(participantId);
    }

    // Akun Pengguna (Admin, Juri, Sekolah)
    match /users/{username} {
      allow read: if true;
      allow write: if isValidId(username);
    }

    // Konfigurasi Kriteria & Juknis Bobot
    match /config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }

    // Pengaturan Logo & Branding
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Formulir Pendaftaran PKS
    match /registrations/{registrationId} {
      allow read: if true;
      allow write: if isValidId(registrationId);
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll([
          'id', 'username', 'userName', 'userRole',
          'actionCategory', 'actionTitle', 'details', 'tabContext',
          'locationStatus', 'dateLabel', 'timeLabel', 'timestampIso'
        ])
        && data.keys().hasOnly([
          'id', 'username', 'userName', 'userRole',
          'actionCategory', 'actionTitle', 'details', 'tabContext',
          'locationStatus', 'latitude', 'longitude', 'accuracy',
          'dateLabel', 'timeLabel', 'timestampIso', 'userAgent'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.username is string && data.username.size() > 0 && data.username.size() <= 100
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 150
        && data.userRole in ['superadmin', 'admin', 'juri', 'sekolah', 'user']
        && data.actionCategory in ['auth', 'navigation', 'scoring', 'registration', 'data_edit', 'data_delete', 'export', 'system']
        && data.actionTitle is string && data.actionTitle.size() > 0 && data.actionTitle.size() <= 150
        && data.details is string && data.details.size() <= 500
        && data.tabContext is string && data.tabContext.size() <= 80
        && data.locationStatus in ['granted', 'denied', 'unavailable', 'timeout']
        && (!('latitude' in data) || data.latitude == null || data.latitude is number)
        && (!('longitude' in data) || data.longitude == null || data.longitude is number)
        && (!('accuracy' in data) || data.accuracy == null || data.accuracy is number)
        && data.dateLabel is string && data.dateLabel.size() > 0 && data.dateLabel.size() <= 20
        && data.timeLabel is string && data.timeLabel.size() > 0 && data.timeLabel.size() <= 20
        && data.timestampIso is string && data.timestampIso.size() > 0 && data.timestampIso.size() <= 50
        && (!('userAgent' in data) || data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 200));
    }

    // Log Aktivitas Pengguna Per Akun (GPS, Tanggal, Waktu)
    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidActivityLog(request.resource.data);
      allow update: if false;
      allow delete: if isValidId(logId);
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
